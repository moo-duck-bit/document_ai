# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/

# Data (large / sensitive)
data/samples/
data/processed/
data/chroma/
*.pdf

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Office temp / probe outputs
~$*.docx
**/_*.docx
**/build.log
**/mdsr_diff_report.txt
**/mdsr_diff_report.json
**/impact_report.json

# Small-A regulatory bench generated runs
data/eval/regulatory_bench/**/runs/

# ── 공개 저장소 제외 규칙 ──────────────────────────────────────────────

# 서드파티 하네스 (Apache-2.0, 별개 업스트림 프로젝트)
ai-engineering-harness/

# DOCX 전면 제외: 생성 산출물(build artifact)이며,
# xxcs 계열은 원본 보안검증보고서의 임베디드 이미지 92개를 그대로 보유
*.docx

# 예외 1 — 빈 EC-SW 양식 (임베디드 콘텐츠 0개, 파이프라인 입력)
!data/templates/ec_sw/template_mdsr.docx
!data/templates/ec_sw/template_mddr.docx

# 예외 2 — 합성 테스트 픽스처 (테스트가 실제로 읽음)
!data/eval/document_set_benchmark_v2/fixtures/**/*.docx

# 루트에 남은 CLI 실행 산출물 (--out 으로 재생성 가능)
/runtime_result.json
/incident_report.json
/improvement_feedback.json
