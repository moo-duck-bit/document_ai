# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Vector store
VECTOR_DB_PATH=./data/chroma

# LLM (choose one)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# LLM_PROVIDER=ollama
